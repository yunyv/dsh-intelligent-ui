{
  "name": "dsh-genui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DSH plugin for generative UI: the model writes an interface instead of describing one. Declarative DSL compiled and executed in a DOM-less Worker sandbox, then drawn by the host with native DOM; a sandboxed-frame escape hatch for anything the component inventory cannot express. Patched in place, persisted with version history.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "assets",
    "cordis.patch.yml",
    "lib",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && tsc -p tsconfig.client-test.json",
    "test": "vitest run",
    "test:vendor": "node --test vendor/dil-replica/replica/test/*.test.js",
    "check": "pnpm run typecheck && pnpm run build && pnpm run test && pnpm run test:vendor",
    "prepare": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^30.1.1",
    "linkedom": "^0.18.13",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "author": "yunyv",
  "homepage": "https://github.com/yunyv/dsh-genui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunyv/dsh-genui.git"
  },
  "bugs": {
    "url": "https://github.com/yunyv/dsh-genui/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "generative-ui",
    "genui",
    "intelligent-ui",
    "artifacts",
    "dil",
    "sandbox",
    "worker",
    "llm",
    "agent",
    "ui"
  ]
}
